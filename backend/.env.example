# ========== Application Configuration ==========
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Kenya Secondary School ERP"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ========== Security ==========
# Generate SECRET_KEY: openssl rand -hex 32
SECRET_KEY=your_jwt_signing_key_here_at_least_32_characters_long

# Generate ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key_here

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ========== Database (PostgreSQL) ==========
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=school_erp_user
POSTGRES_PASSWORD=secure_password_change_in_production
POSTGRES_DB=school_erp_db

# ========== Redis & Celery ==========
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CACHE_URL=redis://localhost:6379/2

# ========== M-Pesa Daraja API (Sandbox) ==========
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_PASSKEY=your_mpesa_stk_push_passkey
MPESA_SHORTCODE=174379
MPESA_EXPRESS_CALLBACK_URL=https://your-domain.com/api/v1/payments/mpesa/stk-callback
MPESA_C2B_VALIDATION_URL=https://your-domain.com/api/v1/payments/mpesa/c2b-validation
MPESA_C2B_CONFIRMATION_URL=https://your-domain.com/api/v1/payments/mpesa/c2b-confirmation
MPESA_CALLBACK_ALLOWED_IPS=196.201.214.200,196.201.214.206,196.201.213.114

# ========== Africa's Talking SMS Gateway ==========
SMS_PROVIDER=africastalking
AT_USERNAME=your_africastalking_username
AT_API_KEY=your_africastalking_api_key
SENDER_ID=SCHOOL

# ========== KRA & Statutory ==========
KRA_EMPLOYER_PIN=P000000001XYZ
KRA_P10_ENDPOINT=https://kraservices.kra.go.ke/
